FROM node:20-alpine

# Instala dependências do sistema necessárias para compilar bibliotecas nativas
RUN apk add --no-cache python3 make g++

WORKDIR /usr/src/app

# Copia os ficheiros de dependências
COPY package*.json ./

# Instala as dependências de produção
RUN npm install

# Copia o código fonte da aplicação
COPY . .

EXPOSE 3000

CMD ["node", "server.js"]